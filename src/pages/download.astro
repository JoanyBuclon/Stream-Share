---
// /download — desktop app landing. Layout, copy and tokens taken from the updated mockup
// (docs/mockup.html, "/download" screen). The Windows row links the installer directly; the button
// below it goes to the repo. macOS/Linux are announced, not shipped (cf. docs/desktop.md
// § Plateformes à venir).
import { Font } from 'astro:assets';
import '../styles/app.css';
// electron/package.json, NOT the root one: the CI job refuses to publish unless the git tag equals
// this exact value (.github/workflows/docker-publish.yml), so it is the only version guaranteed to
// match a real Release. The filename below must stay in step with electron-builder.yml's
// `artifactName` — that pair already cost one silently broken auto-updater.
import { version } from '../../electron/package.json';

const REPO_URL = 'https://github.com/JoanyBuclon/Stream-Share';
// Straight at the installer: one click instead of Releases → assets → find the .exe. The cost is
// that this 404s in the window between bumping the version and the Release going up.
const WINDOWS_INSTALLER_URL = `${REPO_URL}/releases/download/v${version}/StreamShare-Setup-${version}.exe`;
// Published next to the installer by the release job. Same caveat as the URL above: this 404s in
// the window between bumping the version and the Release going up.
const CHECKSUMS_URL = `${REPO_URL}/releases/download/v${version}/SHA256SUMS.txt`;
// Chromium's third-party notices. They used to sit inside the installed app as a 19 MB file nobody
// opened; electron/build/after-pack.cjs now publishes them here instead. This link is not a nicety —
// it is how the BSD/MIT attributions keep travelling with the distribution, so it must not be
// dropped without putting the file back in the installer.
const NOTICES_URL = `${REPO_URL}/releases/download/v${version}/LICENSES.chromium.html`;

// Mono badge + copy per benefit, in the mockup's order.
//
// `soon: true` renders the same "Coming soon" treatment as the macOS/Linux rows below, and it is
// the ONLY way an unshipped feature may appear here. This is the one page a stranger reads before
// trusting us with an unsigned installer, so a promise has to look like a promise — the page used
// to present tone-mapped HDR, guaranteed frame rate and global shortcuts as if they already worked.
// The shortcuts were dropped, "guaranteed 120 fps" turned out to be a non-problem when measured
// (the browser already honours it), and HDR shipped (src/lib/native-video.ts) — so nothing is
// pending right now. Leave the flag: it is the rail the next unshipped card has to go through.
//
// The bar is narrower than "is it good": it has to be something the BROWSER cannot do — that is
// the page's title and the whole argument for downloading anything. Hardware H.265 encoding was
// drafted as a fourth card and pulled for exactly this reason: the codec order lives in
// src/lib/peer.ts, which the web app shares, so a Chrome host on the site already gets it without
// installing a thing. A real benefit, just not one that belongs on this page.
const benefits = [
  {
    tag: 'AUD',
    title: 'Per-app audio',
    soon: false,
    body: 'Tick exactly which apps your friends hear. Share the game, mute Discord — no more echo of your own voice chat.',
  },
  {
    tag: 'SRC',
    title: 'Visual source picker',
    soon: false,
    body: 'A thumbnail grid of every screen and window, with app icons and search. Switch source instantly, no browser prompt.',
  },
  {
    tag: 'HDR',
    title: 'Correct HDR capture',
    soon: false,
    body: 'Tone-mapped capture so HDR games keep their contrast instead of arriving washed out on your friends’ screens.',
  },
  // The catch-all. `items` is rendered as a short list under the body — the only card that uses it,
  // and the reason the field is optional rather than a second component.
  {
    tag: '···',
    title: 'And the small stuff',
    soon: false,
    body: '',
    items: [
      'Desktop notifications when someone joins or leaves',
      'A screen that stays awake even minimised, unlike the browser’s',
      'Updates that install themselves',
    ],
  },
];

// `href: null` renders a disabled "Coming soon" row instead of a download button.
const platforms = [
  { name: 'Windows 10 / 11', detail: `64-bit · v${version} · updates automatically`, href: WINDOWS_INSTALLER_URL },
  { name: 'macOS', detail: 'Apple silicon + Intel', href: null },
  { name: 'Linux', detail: 'AppImage · deb', href: null },
];
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <meta name='theme-color' content='#0a0a0a' />
    <meta
      name='description'
      content='StreamShare for desktop — per-app audio, a visual source picker, and updates that install themselves.'
    />
    <link rel='icon' href='/favicon.svg' type='image/svg+xml' />
    <link rel='icon' href='/favicon.ico' sizes='32x32' />
    <link rel='apple-touch-icon' href='/apple-touch-icon.png' />
    <Font cssVariable='--font-hanken' preload />
    <title>StreamShare — desktop app</title>
  </head>
  <body>
    <div class='flex min-h-dvh flex-col bg-ink'>
      <header class='flex items-center justify-between px-10 py-[26px] max-sm:px-5'>
        <a href='/' class='flex items-center gap-2.5'>
          <img src='/favicon.svg' alt='' class='size-[18px]' />
          <span class='font-semibold tracking-[-0.01em]'>StreamShare</span>
        </a>
        <a href='/' class='font-mono text-xs text-muted-3 transition-colors hover:text-muted-2'>← back to home</a>
      </header>

      <main class='mx-auto w-full max-w-[1000px] flex-1 px-10 py-10 max-sm:px-5 max-sm:py-6'>
        <div class='mb-[52px] max-sm:mb-9'>
          <div class='mb-5 font-mono text-xs uppercase tracking-[0.14em] text-muted-3'>desktop app for windows</div>
          <h1
            class='max-w-[640px] text-[54px] font-semibold leading-[1.04] tracking-[-0.03em] text-balance max-lg:text-[42px] max-sm:text-[31px]'
          >
            Everything the browser won't let you do.
          </h1>
          <p class='mt-[22px] max-w-[520px] text-[17px] leading-[1.6] text-muted'>
            Same rooms, same codes, same viewers in the browser. The desktop app just gives the host real control over
            audio, sources and capture quality.
          </p>
        </div>

        <div class='mb-[52px] grid grid-cols-2 gap-3.5 max-sm:mb-9 max-sm:grid-cols-1'>
          {
            benefits.map((b) => (
              <div class='rounded-2xl border border-white/[0.08] bg-panel p-[22px] transition-transform hover:-translate-y-[3px]'>
                <div class='flex items-center justify-between gap-3'>
                  <span class='flex size-[38px] items-center justify-center rounded-[10px] border border-white/[0.08] bg-elev font-mono text-[9.5px] tracking-[0.06em] text-fg-dim'>
                    {b.tag}
                  </span>
                  {b.soon && (
                    <span class='rounded-lg bg-elev/60 px-3 py-1.5 text-[12px] font-medium text-muted-3'>
                      Coming soon
                    </span>
                  )}
                </div>
                <div class={`mt-4 text-[17px] tracking-[-0.01em] ${b.soon ? 'text-muted-2' : 'font-semibold'}`}>
                  {b.title}
                </div>
                <p class={`mt-1.5 text-[13.5px] leading-[1.6] ${b.soon ? 'text-muted-3' : 'text-muted-2'}`}>{b.body}</p>
                {b.items && (
                  <ul class='mt-3 flex flex-col gap-1.5'>
                    {b.items.map((item) => (
                      <li class='flex gap-2.5 text-[13.5px] leading-[1.5] text-muted-2'>
                        <span class='select-none text-muted-3' aria-hidden='true'>
                          ·
                        </span>
                        {item}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            ))
          }
        </div>

        <div class='max-w-[560px]'>
          <div class='mb-3.5 font-mono text-[10px] uppercase tracking-[0.12em] text-muted-3'>get the app</div>

          <div class='flex flex-col gap-2.5'>
            {
              platforms.map((p) => (
                <div class='flex items-center justify-between gap-4 rounded-xl border border-white/[0.09] bg-panel px-[18px] py-4'>
                  <div>
                    <div class={p.href ? 'text-[15px] font-semibold' : 'text-[15px] text-muted-2'}>{p.name}</div>
                    <div class='mt-0.5 font-mono text-[11px] text-muted-3'>{p.detail}</div>
                  </div>
                  {p.href ? (
                    <a
                      href={p.href}
                      class='shrink-0 cursor-pointer rounded-lg bg-cream px-4 py-2 text-[13px] font-semibold text-ink'
                    >
                      Download
                    </a>
                  ) : (
                    <span class='shrink-0 rounded-lg bg-elev/60 px-4 py-2 text-[13px] font-medium text-muted-3'>
                      Coming soon
                    </span>
                  )}
                </div>
              ))
            }
          </div>

          <!-- New tab: leaving the page would lose the download the visitor came for. It is also
               what the desktop shell keys on — setWindowOpenHandler sends target=_blank straight to
               the system browser instead of loading github.com with our privileged preload. -->
          <a
            href={REPO_URL}
            target='_blank'
            rel='noopener noreferrer'
            class='mt-[26px] block cursor-pointer rounded-xl bg-cream p-[17px] text-center text-base font-semibold text-ink transition-transform hover:-translate-y-[2px]'
          >
            Discover on GitHub
          </a>
          <div class='mt-2.5 text-center font-mono text-[11px] text-muted-3'>source · releases · issues</div>

          <!-- The installer is not code-signed, so SmartScreen has no publisher to vouch for it and
               the updater has no signature to check. Saying so, and offering the checksum, is the
               honest version of what we can actually give: SHA256SUMS.txt is published with each
               release (docker-publish.yml). It catches a truncated or mirrored download — it does
               NOT defend against a compromised release, since both would fall together. Not a
               substitute for a certificate; what there is until there is one. -->
          <p class='mt-[26px] font-mono text-[11px] leading-[1.7] text-muted-4'>
            Windows may show a SmartScreen prompt — click <span class='text-muted-2'>More info → Run anyway</span>. The
            installer is not yet code-signed; verify it against{' '}
            <a
              href={CHECKSUMS_URL}
              target='_blank'
              rel='noopener noreferrer'
              class='cursor-pointer text-muted-2 underline underline-offset-2'
            >
              SHA256SUMS.txt
            </a>{' '}
            with <span class='text-muted-2'>Get-FileHash</span>. Built on Electron —{' '}
            <a
              href={NOTICES_URL}
              target='_blank'
              rel='noopener noreferrer'
              class='cursor-pointer text-muted-2 underline underline-offset-2'
            >
              third-party notices
            </a>.
          </p>
        </div>
      </main>
      <!-- No footer: the mockup's /download screen has none (the landing keeps its own). -->
    </div>
  </body>
</html>
