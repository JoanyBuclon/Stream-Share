---
import { Font } from 'astro:assets';
import '../styles/app.css';
import HomeScreen from '../components/HomeScreen.astro';
import JoinScreen from '../components/JoinScreen.astro';
import HostScreen from '../components/HostScreen.astro';
import ViewerScreen from '../components/ViewerScreen.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="description" content="Share your screen with a single code — direct peer-to-peer, no install, no account." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Font cssVariable="--font-hanken" preload />
    <title>stream share — screen sharing, direct</title>
  </head>
  <body>
    <div id="app" class="flex min-h-dvh flex-col bg-ink">
      <HomeScreen />
      <JoinScreen />
      <HostScreen />
      <ViewerScreen />
    </div>
    <script>
      import { startApp } from '../lib/app.ts';
      startApp();
    </script>
  </body>
</html>
